# Copy this file to .env and fill in values before running `docker compose up`.

# --- Airflow ---
AIRFLOW_UID=50000
# Optional: generate with
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave blank for local learning -- Airflow will generate one at startup with a warning.
FERNET_KEY=
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# --- Warehouse Postgres (used by containers, via the 'warehouse' service name) ---
WAREHOUSE_HOST=warehouse
WAREHOUSE_PORT=5432
WAREHOUSE_DB=weather
WAREHOUSE_USER=weather
WAREHOUSE_PASSWORD=weather
